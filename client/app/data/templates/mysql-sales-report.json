      {
        "id": "MySQL__sales_report",
        "data": {
          "name": "mysql_sales_report",
          "credential_id": "",
          "operation": "execute_query",
          "query": "SELECT c.email, c.full_name, COUNT(o.id) AS order_count, COALESCE(SUM(o.total_amount), 0) AS total_value FROM customers c LEFT JOIN orders o ON o.customer_id = c.id AND o.ordered_at >= $1 WHERE c.status = $2 GROUP BY c.id, c.email, c.full_name ORDER BY total_value DESC;",
          "query_parameters": "[\"2026-01-01 00:00:00\",\"active\"]",
          "query_batching": "single",
          "large_numbers_output": "text",
          "decimal_numbers": false,
          "detailed_output": true,
          "_active_optional_fields": ["query_batching", "large_numbers_output", "decimal_numbers", "detailed_output"]
        },
        "type": "MySQL",
        "position": { "x": 560, "y": 320 }
      },
      {
        "id": "EndNode__mysql_report_end",
        "data": { "name": "mysql_report_result" },
        "type": "EndNode",
        "position": { "x": 860, "y": 320 }
      }
    ],
