# ==================================================================================
# KAI-Flow - Environment Configuration
# ==================================================================================

# Core Application Settings
SECRET_KEY=your-secret-key-here-change-in-production
MASTER_API_KEY=your-api-key-to-access-workflows
CREDENTIAL_MASTER_KEY=credential-master-key-here
# ENCRYPTION_SECRET_KEY=your-encryption-secret-key-here
ENVIRONMENT=development
BACKEND_PORT=23056
PYTHONUNBUFFERED=1
ROOT_PATH=/api/kai

# Database Configuration
DATABASE_URL=postgresql://kai:kai@host.docker.internal:5432/kai
ASYNC_DATABASE_URL=postgresql+asyncpg://kai:kai@127.0.0.1:5432/kai

POSTGRES_DB=kai
POSTGRES_USERNAME=kai
POSTGRES_PASSWORD=kai
DATABASE_SSL=false
DISABLE_DATABASE=false
CREATE_DATABASE=true

# Security
SSL_CERTFILE=cert/cert.pem
SSL_KEYFILE=cert/key.pem

# Optional LangSmith observability (not required for LangChain/LangGraph execution)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=kai-flow-workflows

# Tracing & Debug
KAI_FLOW_LOGGING_PRESET=development
ENABLE_WORKFLOW_TRACING=true
TRACE_AGENT_REASONING=true
TRACE_MEMORY_OPERATIONS=true

# Frontend Configuration
VITE_BASE_PATH=/
VITE_API_BASE_URL=http://localhost:23056
VITE_API_VERSION=/api/v1
VITE_NODE_ENV=development
VITE_ENABLE_LOGGING=true

# Basic Settings
LOG_LEVEL=DEBUG
ALLOWED_ORIGINS=*

# Keycloak Settings
KEYCLOAK_ENABLED=true
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_VERIFY_SSL=false
KEYCLOAK_REALM=agenticgro-dev
KEYCLOAK_CLIENT_ID=agenticgro
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=agenticgro-dev
VITE_KEYCLOAK_CLIENT_ID=agenticgro
ENTERPRISE=false

# ==================================================================================
# OPTIONAL CONFIGURATIONS (uncomment and configure as needed)
# ==================================================================================

# Database Pool Settings
# DB_POOL_SIZE=30
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=10
# DB_POOL_RECYCLE=1800
# DB_POOL_PRE_PING=true

# Authentication & Security
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7
# SESSION_TTL_MINUTES=30
# MAX_SESSIONS=1000

# Rate Limiting & File Upload
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_WINDOW=60
# MAX_FILE_SIZE=10485760
# UPLOAD_DIR=uploads

# Model Security Artifacts
# Keep this directory on persistent storage in production.
# KAI_MODEL_ARTIFACT_DIR=uploads/model-artifacts
# Keep streamed MinIO inputs and crash-recovery staging outside the source tree.
# KAI_MODEL_STAGING_DIR=/var/lib/kai/model-scan-staging
# Local/shared directory totals and MinIO objects: 256 GiB default, 1 TiB hard ceiling.
# KAI_MODEL_MAX_ARTIFACT_BYTES=274877906944
# Expanded ZIP contents: independent 256 GiB default, 1 TiB hard ceiling.
# KAI_MODEL_ARCHIVE_MAX_EXPANDED_BYTES=274877906944
# Browser uploads pass through the application and remain capped at 8 GiB.
# KAI_MODEL_UPLOAD_MAX_BYTES=8589934592
# Static analysis worker memory: 4 GiB default, 16 GiB hard ceiling.
# KAI_MODEL_SCAN_MEMORY_LIMIT_BYTES=4294967296
# Browser uploads are temporary execution inputs. Use shared storage or MinIO
# for reusable model assets.
# KAI_MODEL_MANAGED_RETENTION_SECONDS=86400
# KAI_MODEL_MANAGED_POST_SCAN_RETENTION_SECONDS=3600
# KAI_MODEL_INCOMPLETE_RETENTION_SECONDS=3600
# KAI_MODEL_STAGING_RETENTION_SECONDS=7200
# KAI_MODEL_ARTIFACT_GC_INTERVAL_SECONDS=900
# KAI_MODEL_UPLOAD_RESERVATION_SECONDS=7200
# Disk pressure policy: warn at 75%, evict temporary uploads at 85%, reject at 90%.
# KAI_MODEL_STORAGE_SOFT_PERCENT=75
# KAI_MODEL_STORAGE_AGGRESSIVE_PERCENT=85
# KAI_MODEL_STORAGE_HARD_PERCENT=90
# Keep the greater of 20 GiB or 15% of the volume free.
# KAI_MODEL_STORAGE_MIN_FREE_BYTES=21474836480
# KAI_MODEL_STORAGE_MIN_FREE_PERCENT=15
# Direct local/shared paths are disabled in production/staging until these
# service-visible, read-only roots are configured. JSON works on Windows,
# Linux, and macOS. Docker deployments normally use ["/models"].
# KAI_MODEL_LOCAL_ALLOWED_ROOTS=["/models"]
# Native Windows example: KAI_MODEL_LOCAL_ALLOWED_ROOTS=["D:\\company-models"]

# Workflow Tracing
# ENABLE_WORKFLOW_TRACING=true
# TRACE_AGENT_REASONING=true
# TRACE_MEMORY_OPERATIONS=true

# Enhanced Logging
# Presets: development, production, debugging, minimal, disabled
# KAI_FLOW_LOG_LEVEL=DEBUG
# KAI_FLOW_DEBUG_COMPONENTS=workflow_engine,node_executor
# When true, writes application.log, workflow.log, and workflow_errors.log to
# backend/logs. Files rotate at local midnight and retain 30 daily archives.
# KAI_FLOW_FILE_LOGGING=false
# KAI_FLOW_USE_COLORS=true
# KAI_FLOW_USE_EMOJIS=true

# Third-party API Keys
# OPENAI_API_KEY=your-openai-api-key
# COHERE_API_KEY=your-cohere-api-key
# TAVILY_API_KEY=your-tavily-api-key
# GOOGLE_API_KEY=your-google-api-key

# Engine Settings
# AF_USE_STUB_ENGINE=false

# Development/Testing
# VITE_APP_NAME=KAI-Flow
# ENABLE_DEV_TOOLS=true
# ENABLE_SWAGGER_UI=true
